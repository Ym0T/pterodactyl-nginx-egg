server {
   listen <port> ssl http2; # SSL Configuration - Replace the example <port> with your web port
    server_name <domain>; # SSL Configuration - Replace the example <domain> with your domain

    # Commented out due to this overriding existing configuration already set in nginx/nginx.conf
    # access_log /home/container/logs/naccess.log;
    # error_log  /home/container/logs/nerror.log error;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from 172.18.0.0/16;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;
    
    root /home/container/www;
    index index.html index.htm index.php;
    charset utf-8;
    
    client_max_body_size 100m;
    client_body_timeout 120s;
    sendfile off;
    
     # SSL Configuration - Replace the example <domain> with your domain
    ssl_certificate /home/container/letsencrypt/config/live/<domain>/fullchain.pem;
    ssl_certificate_key /home/container/letsencrypt/config/live/<domain>/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-	POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384";
    ssl_prefer_server_ciphers on;
    
    # See https://hstspreload.org/ before uncommenting the line below.
    # add_header Strict-Transport-Security "max-age=15768000; preload;";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Referrer-Policy "same-origin" always;

    absolute_redirect off;
    port_in_redirect off;
    
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
    
    # PHP or static/SPA mode, generated on startup from nginx/snippets/php-{enabled,disabled}.conf (PHP_STATUS)
    include /home/container/tmp/php-mode.conf;

    # allow larger file uploads and longer script runtimes
    client_max_body_size 100m;
    client_body_timeout 120s;
    sendfile off;
    
    # Block access to sensitive files and directories
    location ~ /\.git {
        deny all;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ /\.svn {
        deny all;
    }

    location ~ /composer\.(json|lock)$ {
        deny all;
    }

    location ~ /package(-lock)?\.json$ {
        deny all;
    }

    location ~ /\.user\.ini$ {
        deny all;
    }

    location ~ /\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$ {
        deny all;
    }
}
